/* SPDX-License-Identifier: (GPL-2.0-or-later OR MIT) */
/*
 * Default U-Boot environment for the Bobcat G285 (CONFIG_ENV_SOURCE_FILE): the memory layout of
 * include/configs/rk3568_common.h, which this file replaces, plus the boot order of docs/updates.md:
 *
 *   1. a bootable SD card (install, rescue), as before;
 *   2. the eMMC's A/B layout (partitions system_a and system_b): RAUC's slot choice with a boot counter per slot;
 *   3. anything else the standard boot finds (extlinux.conf on a bootable partition).
 */

fdtfile=rockchip/rk3566-bobcat-g285.dtb
scriptaddr=0x00c00000
script_offset_f=0xffe000
script_size_f=0x2000
pxefile_addr_r=0x00e00000
kernel_addr_r=0x02000000
kernel_comp_addr_r=0x0a000000
fdt_addr_r=0x12000000
fdtoverlay_addr_r=0x12100000
ramdisk_addr_r=0x12180000
kernel_comp_size=0x8000000
boot_targets=mmc1 mmc0

bobcat_boot=
	bootflow scan -b mmc1;
	if part number mmc 0 system_a slot_a_part && part number mmc 0 system_b slot_b_part; then
		run rauc_boot;
	fi;
	bootflow scan -lb

/*
 * RAUC's U-Boot boot selection (rauc.readthedocs.io, "U-Boot"): BOOT_ORDER lists the slots to try, BOOT_x_LEFT
 * the tries left for each. A try is used up here and saved before the kernel starts; the booted system's
 * rauc-mark-good.service sets it back to 3. A slot that fails three times in a row is skipped, so the other one
 * boots. With no tries left anywhere, all counters are reset and the board starts over.
 */
rauc_boot=
	test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B";
	test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3;
	test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3;
	setenv rauc_part;
	setenv rauc_slot;
	for BOOT_SLOT in "${BOOT_ORDER}"; do
		if test "x${rauc_part}" != "x"; then
			true;
		elif test "x${BOOT_SLOT}" = "xA"; then
			if test ${BOOT_A_LEFT} -gt 0; then
				setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1;
				setenv rauc_part ${slot_a_part};
				setenv rauc_slot A;
			fi;
		elif test "x${BOOT_SLOT}" = "xB"; then
			if test ${BOOT_B_LEFT} -gt 0; then
				setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1;
				setenv rauc_part ${slot_b_part};
				setenv rauc_slot B;
			fi;
		fi;
	done;
	if test "x${rauc_part}" = "x"; then
		echo "A/B: no slot has tries left, resetting the counters";
		setenv BOOT_A_LEFT 3;
		setenv BOOT_B_LEFT 3;
		saveenv;
		reset;
	fi;
	saveenv;
	echo "A/B: booting slot ${rauc_slot} (partition ${rauc_part}), order ${BOOT_ORDER}, left A=${BOOT_A_LEFT} B=${BOOT_B_LEFT}";
	part uuid mmc 0:${rauc_part} rauc_uuid;
	if load mmc 0:${rauc_part} ${kernel_addr_r} /boot/Image && load mmc 0:${rauc_part} ${fdt_addr_r} /boot/rk3566-bobcat-g285.dtb; then
		setenv bootargs "root=PARTUUID=${rauc_uuid} rootwait rw rootfstype=ext4 rauc.slot=${rauc_slot} earlycon console=tty1 console=ttyS2,1500000n8";
		booti ${kernel_addr_r} - ${fdt_addr_r};
	fi;
	echo "A/B: slot ${rauc_slot} did not start, trying again";
	reset
