# U-Boot environment on the eMMC, two copies (CONFIG_ENV_OFFSET / CONFIG_ENV_OFFSET_REDUND in
# bobcat-g285-rk3566_defconfig): before the "uboot" partition at 8 MiB, after the idbloader. Used by RAUC through
# fw_printenv / fw_setenv (docs/updates.md).
/dev/mmcblk0	0x3F8000	0x8000
/dev/mmcblk0	0x3F0000	0x8000
