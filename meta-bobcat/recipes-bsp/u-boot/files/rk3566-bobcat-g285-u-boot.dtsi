/*
 * U-Boot additions to the board's Linux device tree (rk3566-bobcat-g285.dts,
 * built by U-Boot from the same file). EXPERIMENTAL, see
 * docs/experimental-boot-firmware.md.
 */

#include "rk356x-u-boot.dtsi"

/ {
	options {
		u-boot {
			/*
			 * Red from U-Boot's start (as the factory firmware leaves it);
			 * Linux turns it off and lets green heartbeat.
			 */
			boot-led = <&{/leds/led-red}>;
		};
	};
};

/* U-Boot looks LEDs up by label (`led red on`) */
&{/leds/led-red} {
	label = "red";
};

&{/leds/led-green} {
	label = "green";
};

&{/leds/led-blue} {
	label = "blue";
};

/* The micro USB port as a device: `ums` (USB mass storage) and `rockusb` */
&usb_host0_xhci {
	dr_mode = "peripheral";
};
