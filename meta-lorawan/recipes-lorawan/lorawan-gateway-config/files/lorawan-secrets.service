# SPDX-License-Identifier: MIT
[Unit]
Description=Generate gateway secrets on the first boot
ConditionPathExists=!/var/lib/lorawan-secrets/chirpstack.env
Before=chirpstack.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/lorawan-secrets
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
