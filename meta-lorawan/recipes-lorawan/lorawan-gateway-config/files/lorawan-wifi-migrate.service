# SPDX-License-Identifier: MIT
# Moves the Wi-Fi configuration of an older image (/etc/wpa_supplicant, carried over by its update handler) to
# the data partition, once: a factory reset afterwards must not bring it back.
[Unit]
Description=Move the Wi-Fi configuration to /var/lib/lorawan-wifi
DefaultDependencies=no
After=local-fs.target
Before=wpa_supplicant@wlan0.service sysinit.target
ConditionPathExists=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
ConditionPathExists=!/var/lib/lorawan-wifi/.migrated

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'install -d -m 0700 /var/lib/lorawan-wifi && \
    { [ -e /var/lib/lorawan-wifi/wpa_supplicant-wlan0.conf ] || \
      install -m 0600 /etc/wpa_supplicant/wpa_supplicant-wlan0.conf /var/lib/lorawan-wifi/; } && \
    touch /var/lib/lorawan-wifi/.migrated'

[Install]
WantedBy=sysinit.target
