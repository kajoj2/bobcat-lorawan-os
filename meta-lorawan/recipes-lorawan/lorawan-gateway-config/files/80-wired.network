# SPDX-License-Identifier: MIT
# Any wired interface: DHCP (IPv4 and IPv6). mDNS (bobcat-g285.local) is Avahi.
[Match]
Type=ether
Name=en* eth* end*

[Network]
DHCP=yes
LinkLocalAddressing=yes

# Lower metric than Wi-Fi (80-wireless.network): with both up in one network, traffic takes the cable.
[DHCPv4]
UseDomains=yes
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100
