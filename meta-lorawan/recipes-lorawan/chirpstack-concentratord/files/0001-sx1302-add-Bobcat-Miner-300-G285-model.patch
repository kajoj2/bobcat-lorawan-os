diff --git a/chirpstack-concentratord-sx1302/src/config/vendor/bobcat/miner300_g285.rs b/chirpstack-concentratord-sx1302/src/config/vendor/bobcat/miner300_g285.rs
new file mode 100644
index 0000000..3b41348
--- /dev/null
+++ b/chirpstack-concentratord-sx1302/src/config/vendor/bobcat/miner300_g285.rs
@@ -0,0 +1,195 @@
+use anyhow::Result;
+use libconcentratord::{gnss, region};
+use libloragw_sx1302::hal;
+
+use super::super::super::super::config::{self, Region};
+use super::super::{ComType, Configuration, RadioConfig};
+
+// Bobcat Miner 300, board revision G285 (Rockchip RK3566) with its SX1302 + 2x SX1250 mini-PCIe card.
+//
+// Board wiring (https://github.com/docdailey/bobcat-300, docs/os-boot-gpio.md):
+//   * SPI1 -> /dev/spidev1.0
+//   * SX1302 reset: GPIO4_C5 -> gpiochip4 line 21 (pulsed high, then low)
+//   * socket power: GPIO3_D2 -> gpiochip3 line 26 (cycled by the factory reset script)
+//   * the socket rail GPIO3_D5 is an always-on regulator in the device tree
+//   * no STTS751 temperature sensor on the card, so no I2C temperature compensation
+//
+// RF parameters (RSSI offset and temperature compensation, TX gain table, single input mode off) are the factory
+// firmware's EU868 values (global_conf_sx1250_eu868.json on a G285, 2026-11-17): the card's PA differs from Semtech's.
+pub fn new(conf: &config::Configuration) -> Result<Configuration> {
+    let region = conf.gateway.region.unwrap_or(Region::EU868);
+
+    let tx_min_max_freqs = match region {
+        Region::EU868 => region::eu868::TX_MIN_MAX_FREQS.to_vec(),
+        Region::IN865 => region::in865::TX_MIN_MAX_FREQS.to_vec(),
+        Region::RU864 => region::ru864::TX_MIN_MAX_FREQS.to_vec(),
+        _ => return Err(anyhow!("Region is not supported: {}", region)),
+    };
+
+    let gps = conf.gateway.model_flags.contains(&"GNSS".to_string());
+    let enforce_duty_cycle = conf.gateway.model_flags.contains(&"ENFORCE_DC".to_string());
+
+    Ok(Configuration {
+        enforce_duty_cycle,
+        radio_count: 2,
+        clock_source: 0,
+        full_duplex: false,
+        lora_multi_sf_bandwidth: 125000,
+        radio_config: vec![
+            RadioConfig {
+                tx_min_max_freqs,
+                radio_type: hal::RadioType::SX1250,
+                single_input_mode: false,
+                rssi_offset: -215.4,
+                rssi_temp_compensation: hal::RssiTempCompensationConfig {
+                    coeff_a: 0.0,
+                    coeff_b: 0.0,
+                    coeff_c: 20.41,
+                    coeff_d: 2162.56,
+                    coeff_e: 0.0,
+                },
+                tx_enable: true,
+                tx_gain_table: vec![
+                    // 0
+                    hal::TxGainConfig {
+                        rf_power: 10,
+                        pa_gain: 1,
+                        pwr_idx: 2,
+                        ..Default::default()
+                    },
+                    // 1
+                    hal::TxGainConfig {
+                        rf_power: 12,
+                        pa_gain: 1,
+                        pwr_idx: 4,
+                        ..Default::default()
+                    },
+                    // 2
+                    hal::TxGainConfig {
+                        rf_power: 13,
+                        pa_gain: 1,
+                        pwr_idx: 5,
+                        ..Default::default()
+                    },
+                    // 3
+                    hal::TxGainConfig {
+                        rf_power: 14,
+                        pa_gain: 1,
+                        pwr_idx: 6,
+                        ..Default::default()
+                    },
+                    // 4
+                    hal::TxGainConfig {
+                        rf_power: 15,
+                        pa_gain: 1,
+                        pwr_idx: 7,
+                        ..Default::default()
+                    },
+                    // 5
+                    hal::TxGainConfig {
+                        rf_power: 16,
+                        pa_gain: 1,
+                        pwr_idx: 8,
+                        ..Default::default()
+                    },
+                    // 6
+                    hal::TxGainConfig {
+                        rf_power: 17,
+                        pa_gain: 1,
+                        pwr_idx: 9,
+                        ..Default::default()
+                    },
+                    // 7
+                    hal::TxGainConfig {
+                        rf_power: 18,
+                        pa_gain: 1,
+                        pwr_idx: 10,
+                        ..Default::default()
+                    },
+                    // 8
+                    hal::TxGainConfig {
+                        rf_power: 19,
+                        pa_gain: 1,
+                        pwr_idx: 11,
+                        ..Default::default()
+                    },
+                    // 9
+                    hal::TxGainConfig {
+                        rf_power: 20,
+                        pa_gain: 1,
+                        pwr_idx: 12,
+                        ..Default::default()
+                    },
+                    // 10
+                    hal::TxGainConfig {
+                        rf_power: 21,
+                        pa_gain: 1,
+                        pwr_idx: 13,
+                        ..Default::default()
+                    },
+                    // 11
+                    hal::TxGainConfig {
+                        rf_power: 22,
+                        pa_gain: 1,
+                        pwr_idx: 14,
+                        ..Default::default()
+                    },
+                    // 12
+                    hal::TxGainConfig {
+                        rf_power: 23,
+                        pa_gain: 1,
+                        pwr_idx: 16,
+                        ..Default::default()
+                    },
+                    // 13
+                    hal::TxGainConfig {
+                        rf_power: 24,
+                        pa_gain: 1,
+                        pwr_idx: 17,
+                        ..Default::default()
+                    },
+                    // 14
+                    hal::TxGainConfig {
+                        rf_power: 25,
+                        pa_gain: 1,
+                        pwr_idx: 19,
+                        ..Default::default()
+                    },
+                    // 15
+                    hal::TxGainConfig {
+                        rf_power: 26,
+                        pa_gain: 1,
+                        pwr_idx: 22,
+                        ..Default::default()
+                    },
+                ],
+            },
+            RadioConfig {
+                radio_type: hal::RadioType::SX1250,
+                single_input_mode: false,
+                rssi_offset: -215.4,
+                rssi_temp_compensation: hal::RssiTempCompensationConfig {
+                    coeff_a: 0.0,
+                    coeff_b: 0.0,
+                    coeff_c: 20.41,
+                    coeff_d: 2162.56,
+                    coeff_e: 0.0,
+                },
+                tx_enable: false,
+                tx_min_max_freqs: vec![],
+                tx_gain_table: vec![],
+            },
+        ],
+        gnss: match gps {
+            true => conf
+                .gateway
+                .get_gnss_dev_path(&gnss::Device::new("/dev/ttyS5")),
+            false => gnss::Device::None,
+        },
+        com_type: ComType::Spi,
+        com_path: conf.gateway.get_com_dev_path("/dev/spidev1.0"),
+        sx1302_reset_pin: conf.gateway.get_sx1302_reset_pin("/dev/gpiochip4", 21),
+        sx1302_power_en_pin: conf.gateway.get_sx1302_power_en_pin("/dev/gpiochip3", 26),
+        ..Default::default()
+    })
+}
