# SPDX-License-Identifier: MIT
[Unit]
Description=LoRaWAN gateway status panel (port 80) and LED status
Documentation=https://github.com/kajoj2/bobcat-lorawan-os/blob/main/docs/lorawan-agent.md
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
ExecStart=/usr/bin/lorawan-agent serve
# Back to the device tree's green heartbeat when the agent stops
ExecStopPost=-/usr/bin/lorawan-agent led-reset
Restart=always
RestartSec=5
# Root for port 80 and the LED files in /sys; everything else read-only, except the forwarding server list the
# panel writes (/var/lib/lorawan-forward, read by chirpstack-udp-forwarder.service) and an uploaded update bundle
# (/var/lib/lorawan-update, installed by RAUC's own service), and the Home Assistant bridge Mosquitto includes
# (/var/lib/lorawan-mqtt-bridge, created by tmpfiles.d with Mosquitto's group)
ProtectSystem=strict
StateDirectory=lorawan-forward lorawan-update
ReadWritePaths=-/var/lib/lorawan-mqtt-bridge
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
