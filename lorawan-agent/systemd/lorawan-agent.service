# SPDX-License-Identifier: MIT
[Unit]
Description=LoRaWAN gateway status panel (port 80) and LED status
Documentation=https://github.com/kajoj2/bobcat-lorawan-os/blob/main/docs/lorawan-agent.md
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
ExecStart=/usr/bin/lorawan-agent serve
# Back to the device tree's green heartbeat when the agent stops
ExecStopPost=-/usr/bin/lorawan-agent led-reset
Restart=always
RestartSec=5
# Root for port 80, DNS on the setup network (port 53), the button's input device and the LED files in /sys;
# everything else read-only, except the forwarding server list the panel writes (/var/lib/lorawan-forward, read
# by chirpstack-udp-forwarder.service), an uploaded update bundle (/var/lib/lorawan-update, installed by RAUC's
# own service), the setup wizard's Wi-Fi request (/var/lib/lorawan-setup, installed by lorawan-setup-wifi) and
# the Home Assistant bridge Mosquitto includes (/var/lib/lorawan-mqtt-bridge, created by tmpfiles.d with
# Mosquitto's group), the Devices card's list and settings (/var/lib/lorawan-alerts), the WireGuard tunnel and its
# firewall rule (/var/lib/lorawan-wireguard, /var/lib/lorawan-firewall) and the BLE switch (/var/lib/lorawan-ble)
ProtectSystem=strict
StateDirectory=lorawan-forward lorawan-update lorawan-setup lorawan-alerts lorawan-wireguard lorawan-ble
ReadWritePaths=-/var/lib/lorawan-mqtt-bridge -/var/lib/lorawan-firewall
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
